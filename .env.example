# Required (reviewers use their own key)
OPENAI_API_KEY=

# Model
OPENAI_MODEL=gpt-5.6-terra
# Empty omits the reasoning parameter (use this with non-reasoning models)
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=60

# Safety and operations
TRIAGE_AUTO_RESPOND=true          # false = kill switch: nothing is answered without a person
TRIAGE_CONFIDENCE_THRESHOLD=0.6
TRIAGE_TIMEOUT_SECONDS=90
TRIAGE_BREAKER_THRESHOLD=3
TRIAGE_ALERT_RATIO=0.2
TRIAGE_MAX_MESSAGE_CHARS=4000
TRIAGE_DEAD_LETTER=failed_tickets.jsonl
TRIAGE_OUTBOX=outbox              # where --execute writes replies, handoffs, feature requests
